{
  "id": "big_digital",
  "name": "Big Digital",
  "canvas": "roundedRect",
  "layers": [
    {
      "id": "backdrop_normal",
      "type": "shape",
      "shape": "roundedRect",
      "x": 0.0,
      "y": 0.0,
      "width": 1.88,
      "height": 1.88,
      "cornerRadius": 0.24,
      "fillColor": "#080B12",
      "strokeColor": "#1E293B",
      "strokeWidthDp": 1.5,
      "mode": "normal"
    },
    {
      "id": "battery_arc",
      "type": "gauge",
      "source": "battery",
      "x": 0.0,
      "y": 0.0,
      "radius": 0.82,
      "startAngle": -225,
      "sweepAngle": 270,
      "thicknessDp": 5.0,
      "cap": "round",
      "trackColor": "#1E293B",
      "fillColor": "@primary",
      "mode": "both"
    },
    {
      "id": "date_header",
      "type": "text",
      "template": "{dayName}, {monthName} {day}",
      "x": 0.0,
      "y": -0.44,
      "size": 0.115,
      "weight": "bold",
      "align": "center",
      "color": "@primary",
      "letterSpacing": 0.06,
      "font": "sans",
      "mode": "both"
    },
    {
      "id": "big_time",
      "type": "text",
      "template": "{hour}:{minute}",
      "x": 0.0,
      "y": -0.04,
      "size": 0.44,
      "weight": "bold",
      "align": "center",
      "color": "#FFFFFF",
      "font": "mono",
      "mode": "both"
    },
    {
      "id": "ampm_label",
      "type": "text",
      "template": "{ampm}",
      "x": -0.22,
      "y": 0.26,
      "size": 0.10,
      "weight": "bold",
      "align": "center",
      "color": "#94A3B8",
      "font": "sans",
      "mode": "both"
    },
    {
      "id": "seconds_pill",
      "type": "slot",
      "template": "{second}s",
      "x": 0.18,
      "y": 0.26,
      "width": 0.36,
      "height": 0.16,
      "cornerRadius": 0.08,
      "fillColor": "#162032",
      "strokeColor": "@primary",
      "strokeWidthDp": 1.0,
      "textSize": 0.095,
      "textColor": "@primary",
      "weight": "bold",
      "font": "mono",
      "mode": "normal"
    },
    {
      "id": "battery_label",
      "type": "text",
      "template": "BAT {battery}",
      "x": 0.0,
      "y": 0.47,
      "size": 0.085,
      "weight": "medium",
      "align": "center",
      "color": "#94A3B8",
      "font": "mono",
      "mode": "normal"
    },
    {
      "id": "next_event_line",
      "type": "text",
      "template": "{nextEventTime}  {nextEventTitle}",
      "x": 0.0,
      "y": 0.66,
      "size": 0.095,
      "weight": "medium",
      "align": "center",
      "color": "@onSurface",
      "font": "sans",
      "showWhen": "hasNextEvent",
      "mode": "both"
    }
  ]
}
