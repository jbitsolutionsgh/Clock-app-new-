{
  "id": "minimal_plus",
  "name": "Minimal Plus",
  "canvas": "circle",
  "layers": [
    {
      "id": "outer_ring",
      "type": "shape",
      "shape": "ring",
      "radius": 0.96,
      "strokeColor": "#1E293B",
      "strokeWidthDp": 2.0,
      "mode": "both"
    },
    {
      "id": "dial_ticks",
      "type": "ticks",
      "count": 60,
      "innerRadius": 0.88,
      "outerRadius": 0.94,
      "widthDp": 1.4,
      "color": "#475569",
      "cap": "round",
      "majorEvery": 5,
      "majorInnerRadius": 0.79,
      "majorWidthDp": 3.0,
      "majorColor": "@primary",
      "mode": "both"
    },
    {
      "id": "battery_gauge",
      "type": "gauge",
      "source": "battery",
      "x": 0.0,
      "y": -0.34,
      "radius": 0.17,
      "startAngle": -220,
      "sweepAngle": 260,
      "thicknessDp": 4.0,
      "cap": "round",
      "trackColor": "#1E293B",
      "fillColor": "@primary",
      "mode": "both"
    },
    {
      "id": "battery_text",
      "type": "text",
      "template": "{battery}",
      "x": 0.0,
      "y": -0.34,
      "size": 0.085,
      "weight": "bold",
      "align": "center",
      "color": "@onSurface",
      "font": "mono",
      "mode": "both"
    },
    {
      "id": "date_slot",
      "type": "slot",
      "template": "{dayName} {day}",
      "x": 0.0,
      "y": 0.44,
      "width": 0.44,
      "height": 0.16,
      "cornerRadius": 0.04,
      "fillColor": "#111827",
      "strokeColor": "@primary",
      "strokeWidthDp": 1.2,
      "textSize": 0.085,
      "textColor": "@onSurface",
      "weight": "bold",
      "font": "mono",
      "mode": "both"
    },
    {
      "id": "hour_hand",
      "type": "hand",
      "source": "hour",
      "length": 0.48,
      "tailDp": 10,
      "widthDp": 6.5,
      "cap": "round",
      "bodyColor": "@onSurface",
      "stripeColor": "@primary",
      "stripeWidthDp": 2.4,
      "stripeTipOnly": true,
      "shadow": true,
      "shadowAlpha": 0.45,
      "mode": "both"
    },
    {
      "id": "minute_hand",
      "type": "hand",
      "source": "minute",
      "length": 0.74,
      "tailDp": 12,
      "widthDp": 4.5,
      "cap": "round",
      "bodyColor": "@onSurface",
      "stripeColor": "@primary",
      "stripeWidthDp": 1.8,
      "stripeTipOnly": true,
      "shadow": true,
      "shadowAlpha": 0.45,
      "mode": "both"
    },
    {
      "id": "second_hand",
      "type": "hand",
      "source": "second",
      "length": 0.86,
      "tailDp": 20,
      "widthDp": 1.8,
      "cap": "round",
      "bodyColor": "@primary",
      "smooth": true,
      "shadow": true,
      "shadowAlpha": 0.45,
      "mode": "normal"
    },
    {
      "id": "center_cap_outer",
      "type": "shape",
      "shape": "circle",
      "radiusDp": 5.5,
      "fillColor": "@primary",
      "mode": "both"
    },
    {
      "id": "center_cap_inner",
      "type": "shape",
      "shape": "circle",
      "radiusDp": 2.2,
      "fillColor": "#000000",
      "mode": "both"
    }
  ]
}
